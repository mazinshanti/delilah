{
  "expo": {
    "name": "Dalelah",
    "slug": "dalelah",
    "scheme": "dalelah",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.dalelah.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "sa.dalelah.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0F4D3A"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
